{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/1052326311/dsh-plan-lattice/eval/v0.4/run-result.schema.json",
  "title": "Plan Lattice v0.4 append-only run result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "attemptId", "runId", "attempt", "phase", "suite", "armId", "status", "manifestDigest", "artifactDigest", "driverPayloadDigest", "driverStdoutDigest", "previousRecordDigest", "controllerReceiptDigest", "recordDigest", "recordSignature", "startedAt", "finishedAt"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "attemptId": { "type": "string", "minLength": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "attempt": { "type": "integer", "minimum": 1 },
    "rerunOfAttemptId": { "type": "string" },
    "phase": { "enum": ["infrastructure", "statistical"] },
    "suite": { "enum": ["simple", "icae", "evocode"] },
    "armId": { "type": "string" },
    "status": { "enum": ["completed", "failed"] },
    "manifestDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "artifactDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "driverPayloadDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "driverStdoutDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "previousRecordDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "controllerReceiptDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "recordDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "recordSignature": { "type": "string", "pattern": "^[A-Za-z0-9+/]+={0,2}$" },
    "startedAt": { "type": "string", "format": "date-time" },
    "finishedAt": { "type": "string", "format": "date-time" },
    "failure": {
      "type": "object",
      "required": ["classification", "code", "message"],
      "properties": {
        "classification": { "enum": ["infrastructure", "task"] },
        "code": { "type": "string" },
        "message": { "type": "string" }
      }
    },
    "metrics": {
      "type": "object",
      "properties": {
        "score": { "type": "number", "minimum": 0 },
        "maxScore": { "type": "number", "exclusiveMinimum": 0 },
        "hiddenFeatureScore": { "type": "number", "minimum": 0 },
        "criticalRequirementsMissed": { "type": "number", "minimum": 0 },
        "historicalRequirementRegressions": { "type": "number", "minimum": 0 },
        "cumulativeCaseScore": { "type": "number", "minimum": 0 },
        "modelTurns": { "type": "number", "minimum": 0 },
        "inputTokens": { "type": "number", "minimum": 0 },
        "outputTokens": { "type": "number", "minimum": 0 },
        "durationMs": { "type": "number", "minimum": 0 },
        "clarificationQuestions": { "type": "number", "minimum": 0 }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["graderDigest", "taskDigest", "harnessCommit", "modelId", "modelConfigDigest", "runtimePolicyDigest", "endpointDigest", "sourceLockDigest", "runtimeArtifactsDigest", "driverSourceDigest", "pluginCommit"],
      "properties": {
        "graderDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "taskDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "harnessCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "modelId": { "type": "string" },
        "modelConfigDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "runtimePolicyDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "endpointDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "sourceLockDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "runtimeArtifactsDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "driverSourceDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "pluginCommit": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "stderrDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
