{
  "name": "dsh-plan-lattice",
  "version": "0.4.0-rc.0",
  "description": "Adaptive execution contracts and evidence-gated work graphs for DeepSeek Harness agents",
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "agent",
    "long-horizon",
    "planning",
    "context-engineering",
    "evidence"
  ],
  "homepage": "https://github.com/1052326311/dsh-plan-lattice#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1052326311/dsh-plan-lattice.git"
  },
  "bugs": {
    "url": "https://github.com/1052326311/dsh-plan-lattice/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run && pnpm run test:eval",
    "test:eval": "node --test eval/v0.4/tests/*.testcase.mjs",
    "router:v2:collect": "node eval/router-corpus/v2/collect-candidates.mjs",
    "router:v2:adjudication": "node eval/router-corpus/v2/build-adjudication.mjs",
    "router:v2:freeze": "node eval/router-corpus/v2/freeze-blind.mjs",
    "router:v2:evaluate": "pnpm run build && node eval/router-corpus/v2/evaluate-blind.mjs",
    "router:v3:collect": "node eval/router-corpus/v3/collect-candidates.mjs",
    "router:v3:adjudication": "node eval/router-corpus/v3/build-adjudication.mjs",
    "router:v3:freeze": "node eval/router-corpus/v3/freeze-blind.mjs",
    "router:v3:evaluate": "pnpm run build && node eval/router-corpus/v3/evaluate-blind.mjs",
    "router:v4:collect": "node eval/router-corpus/v4/collect-candidates.mjs",
    "router:v4:collect-supplement": "node eval/router-corpus/v4/collect-supplement.mjs",
    "router:v4:assemble-supplement": "node eval/router-corpus/v4/assemble-supplement.mjs",
    "router:v4:adjudication": "node eval/router-corpus/v4/build-adjudication.mjs",
    "router:v4:supplement-adjudication": "node eval/router-corpus/v4/build-adjudication.mjs --supplement",
    "router:v4:freeze": "node eval/router-corpus/v4/freeze-blind.mjs",
    "router:v4:evaluate": "pnpm run build && node eval/router-corpus/v4/evaluate-blind.mjs",
    "router:v4:analyze": "node eval/router-corpus/v4/analyze-failures.mjs",
    "router:v4:development": "pnpm run build && node eval/router-corpus/v4/evaluate-development.mjs",
    "router:v5:sources": "node eval/router-corpus/v5/source-isolation.mjs",
    "router:v5:collect": "node eval/router-corpus/v5/collect-candidates.mjs",
    "router:v5:adjudication": "node eval/router-corpus/v5/build-adjudication.mjs",
    "router:v5:freeze": "node eval/router-corpus/v5/freeze-blind.mjs",
    "router:v5:evaluate": "pnpm run build && node eval/router-corpus/v5/evaluate-blind.mjs",
    "router:v5:analyze": "node eval/router-corpus/v5/analyze-failures.mjs",
    "router:v6:sources": "node eval/router-corpus/v6/source-isolation.mjs",
    "router:v6:collect": "node eval/router-corpus/v6/collect-candidates.mjs",
    "router:v6:agreement": "node eval/router-corpus/v6/agreement.mjs eval/router-corpus/v6/annotations-a.jsonl eval/router-corpus/v6/annotations-b.jsonl eval/router-corpus/v6/annotations-c.jsonl",
    "router:v6:adjudication": "node eval/router-corpus/v6/build-adjudication.mjs",
    "router:v6:freeze": "node eval/router-corpus/v6/freeze-blind.mjs",
    "router:v6:evaluate": "pnpm run build && node eval/router-corpus/v6/evaluate-blind.mjs",
    "router:v7:calibration": "node eval/router-corpus/v7/build-calibration.mjs",
    "router:v7:calibration:round2": "node eval/router-corpus/v7/assemble-calibration-round2.mjs",
    "router:v7:sources": "node eval/router-corpus/v7/source-isolation.mjs",
    "router:v7:collect": "node eval/router-corpus/v7/collect-candidates.mjs",
    "router:v7:agreement": "node eval/router-corpus/v7/agreement.mjs",
    "router:v7:adjudication": "node eval/router-corpus/v7/build-adjudication.mjs",
    "router:v7:freeze": "node eval/router-corpus/v7/freeze-blind.mjs",
    "router:v7:evaluate": "pnpm run build && node eval/router-corpus/v7/evaluate-blind.mjs",
    "router:v8:registry": "node eval/router-corpus/v8/freeze-source-registry.mjs",
    "router:v8:assemble": "node eval/router-corpus/v8/assemble-candidates.mjs",
    "router:model:train": "pnpm run build && node scripts/train-router-model.mjs",
    "prepack": "pnpm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-user-questions": "^0.1.0-rc.6"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-user-questions": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.6",
    "@deepseek-ai/dsh-compaction": "0.1.0-rc.6",
    "@deepseek-ai/dsh-invariants": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6",
    "@deepseek-ai/dsh-scope": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "0.1.0-rc.6",
    "@deepseek-ai/dsh-system-prompt": "0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-user-questions": "0.1.0-rc.6",
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
